# Neon Postgres connection string (pooled — used by the app at runtime).
# Get it from the Neon dashboard → your project → "Connection string".
# It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/clidesk?sslmode=require"

# Optional: non-pooled (direct) URL used only for migrations / `prisma db push`.
# In Neon this is the same host WITHOUT "-pooler". If you only have one URL,
# you can set DIRECT_URL to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/clidesk?sslmode=require"
