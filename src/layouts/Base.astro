---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'CLIDesk' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CLIDesk — your personal vault for commands, shortcuts, snippets, tools and links." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arima:wght@400;500;700&family=Arimo:wght@400;700&family=Caveat:wght@400;600;700&family=Dancing+Script:wght@400;600;700&family=DM+Sans:wght@400;500;700&family=Indie+Flower&family=Merienda:wght@300..900&family=Poppins:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Playwrite families kept in a separate request so a failure here can't block the others -->
    <link
      href="https://fonts.googleapis.com/css2?family=Playwrite+AU+VIC+Guides&family=Playwrite+GB+J&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
