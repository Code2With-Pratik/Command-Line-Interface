---
import Base from '../layouts/Base.astro';
import { getUser } from '../lib/auth';

export const prerender = false;

// Already logged in? Go straight to the workspace.
const user = await getUser(Astro.cookies);
if (user) return Astro.redirect('/app');

// ASCII banner shown in the intro splash ("COMMAND LINE INTERFACE").
const introArt = `░░░░░░  ░░░░░░  ░░░    ░░░ ░░░    ░░░  ░░░░░  ░░░    ░░ ░░░░░░      ░░      ░░ ░░░    ░░ ░░░░░░░     ░░ ░░░    ░░ ░░░░░░░░ ░░░░░░░ ░░░░░░  ░░░░░░░  ░░░░░   ░░░░░░ ░░░░░░░
▒▒      ▒▒    ▒▒ ▒▒▒▒  ▒▒▒▒ ▒▒▒▒  ▒▒▒▒ ▒▒   ▒▒ ▒▒▒▒   ▒▒ ▒▒   ▒▒     ▒▒      ▒▒ ▒▒▒▒   ▒▒ ▒▒          ▒▒ ▒▒▒▒   ▒▒    ▒▒    ▒▒      ▒▒   ▒▒ ▒▒      ▒▒   ▒▒ ▒▒      ▒▒
▒▒      ▒▒    ▒▒ ▒▒ ▒▒▒▒ ▒▒ ▒▒ ▒▒▒▒ ▒▒ ▒▒▒▒▒▒▒ ▒▒ ▒▒  ▒▒ ▒▒   ▒▒     ▒▒      ▒▒ ▒▒ ▒▒  ▒▒ ▒▒▒▒▒       ▒▒ ▒▒ ▒▒  ▒▒    ▒▒    ▒▒▒▒▒   ▒▒▒▒▒▒  ▒▒▒▒▒   ▒▒▒▒▒▒▒ ▒▒      ▒▒▒▒▒
▓▓      ▓▓    ▓▓ ▓▓  ▓▓  ▓▓ ▓▓  ▓▓  ▓▓ ▓▓   ▓▓ ▓▓  ▓▓ ▓▓ ▓▓   ▓▓     ▓▓      ▓▓ ▓▓  ▓▓ ▓▓ ▓▓          ▓▓ ▓▓  ▓▓ ▓▓    ▓▓    ▓▓      ▓▓   ▓▓ ▓▓      ▓▓   ▓▓ ▓▓      ▓▓
 ██████  ██████  ██      ██ ██      ██ ██   ██ ██   ████ ██████      ███████ ██ ██   ████ ███████     ██ ██   ████    ██    ███████ ██   ██ ██      ██   ██  ██████ ███████`;
---

<Base title="CLIDesk — Sign in">
  <!-- intro splash: logo centres, then glides left as the title slides out of it -->
  <div id="intro" class="fixed inset-0 z-[200] grid place-items-center overflow-hidden">
    <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-10 px-3 max-w-[98vw]">
      <div class="intro-logo w-16 h-16 sm:w-20 sm:h-20 rounded-3xl grid place-items-center shrink-0"
           style="background:linear-gradient(135deg,#fde047,#f97316);box-shadow:0 16px 50px -10px rgba(249,115,22,.65)">
        <span class="font-heading text-3xl sm:text-4xl font-bold" style="color:#1a1205">&gt;_</span>
      </div>
      <pre class="intro-text grad-text font-mono whitespace-pre leading-[1.05] m-0 select-none shrink-0" style="font-size:clamp(1.9px,0.72vw,10px)">{introArt}</pre>
    </div>
  </div>

  <main class="min-h-screen w-full flex items-center justify-center px-5 py-10">
    <div class="w-full max-w-5xl grid md:grid-cols-2 gap-10 items-center">
      <!-- Brand / pitch -->
      <section class="hidden md:block animate-rise">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl grid place-items-center"
               style="background:linear-gradient(135deg,#fde047,#f97316);box-shadow:0 10px 30px -8px rgba(249,115,22,.6)">
            <span class="font-heading text-2xl font-bold" style="color:#1a1205">&gt;_</span>
          </div>
          <span class="font-heading text-3xl grad-text">CLIDesk</span>
        </div>
        <h1 class="font-heading text-4xl leading-tight mb-4 grad-text">
          Your personal vault for commands,
          shortcuts, snippets, tools &amp; links.
        </h1>
        <p class="text-xl text-mist-300 leading-relaxed">
          Organise everything into boards. Drop a command, a code snippet, a handy URL —
          colour-code it, pin it, star it, and find it in a blink with
          <kbd class="px-2 py-0.5 rounded bg-ink-700 border border-ink-600 text-mist-200">Ctrl</kbd>
          +
          <kbd class="px-2 py-0.5 rounded bg-ink-700 border border-ink-600 text-mist-200">K</kbd>.
        </p>
        <ul class="mt-7 space-y-3 text-lg text-mist-200">
          <li class="flex items-center gap-3"><span class="text-accent-soft text-xl">✦</span> VS Code-style syntax colours for code</li>
          <li class="flex items-center gap-3"><span class="text-accent-soft text-xl">✦</span> Full-screen card view, export to image or PDF</li>
          <li class="flex items-center gap-3"><span class="text-accent-soft text-xl">✦</span> Pin &amp; favourite the things you reach for most</li>
        </ul>
      </section>

      <!-- Auth card -->
      <section class="glass rounded-3xl p-7 sm:p-9 animate-pop shadow-2xl">
        <div class="md:hidden flex items-center gap-3 mb-6 justify-center">
          <div class="w-10 h-10 rounded-xl grid place-items-center"
               style="background:linear-gradient(135deg,#fde047,#f97316)">
            <span class="font-heading text-xl font-bold" style="color:#1a1205">&gt;_</span>
          </div>
          <span class="font-heading text-2xl grad-text">CLIDesk</span>
        </div>

        <!-- tab switch -->
        <div class="grid grid-cols-2 p-1 rounded-xl bg-ink-800 border border-ink-600 mb-7">
          <button id="tab-login" class="py-2 rounded-lg font-heading text-lg transition">Log in</button>
          <button id="tab-signup" class="py-2 rounded-lg font-heading text-lg transition">Sign up</button>
        </div>

        <form id="auth-form" class="space-y-4" novalidate>
          <div id="name-wrap" class="space-y-1 overflow-hidden transition-all duration-300 ease-out" style="max-height:0;opacity:0">
            <label class="label-sm" for="username">Name</label>
            <input class="field" id="username" name="username" type="text" autocomplete="name" placeholder="Ada Lovelace" />
          </div>
          <div class="space-y-1">
            <label class="label-sm" for="email">Email</label>
            <input class="field" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          </div>
          <div class="space-y-1">
            <div class="flex items-center justify-between gap-2">
              <label class="label-sm" for="password">Password</label>
              <button type="button" id="forgot-btn" class="text-sm text-accent-soft hover:underline">Forgot password?</button>
            </div>
            <div class="relative">
              <input class="field pr-11" id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required />
              <button type="button" id="toggle-pass" class="absolute right-2 top-1/2 -translate-y-1/2 grid place-items-center w-8 h-8 rounded-lg text-mist-400 hover:text-mist-100" aria-label="Show password">
                <span id="eye-icon"></span>
              </button>
            </div>
          </div>

          <button id="auth-submit" type="submit" class="btn btn-primary w-full text-lg mt-1">
            <span id="auth-submit-label">Log in</span>
          </button>
        </form>

        <p class="text-center text-mist-400 mt-5 text-base" id="switch-hint"></p>
      </section>
    </div>
  </main>

  <!-- toast notifications -->
  <div id="toast-stack" class="fixed top-6 left-1/2 -translate-x-1/2 z-[70] flex flex-col items-center gap-2 w-[min(420px,92vw)]"></div>

  <!-- reset password overlay -->
  <div id="reset-overlay" class="fixed inset-0 z-[120] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm animate-fade" data-reset-close></div>
    <div class="relative w-[min(360px,92vw)] glass rounded-3xl p-7 shadow-2xl animate-pop">
      <h3 class="font-heading text-2xl mb-1">Reset password</h3>
      <p class="text-mist-300 text-sm mb-4 leading-relaxed">Enter your email and a new password.</p>
      <form id="reset-form" class="space-y-3" novalidate>
        <input class="field" id="reset-email" type="email" autocomplete="email" placeholder="you@example.com" />
        <input class="field" id="reset-pass" type="password" autocomplete="new-password" placeholder="New password" />
        <input class="field" id="reset-pass2" type="password" autocomplete="new-password" placeholder="Confirm new password" />
        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <button type="button" class="btn btn-ghost w-full justify-center" data-reset-close>Cancel</button>
          <button type="submit" id="reset-submit" class="btn btn-primary w-full justify-center">Reset</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    type Mode = 'login' | 'signup';
    let mode: Mode = 'login';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const tabLogin = $('tab-login') as HTMLButtonElement;
    const tabSignup = $('tab-signup') as HTMLButtonElement;
    const nameWrap = $('name-wrap');
    const form = $('auth-form') as HTMLFormElement;
    const submitLabel = $('auth-submit-label');
    const submitBtn = $('auth-submit') as HTMLButtonElement;
    const switchHint = $('switch-hint');

    // ---- toast notifications -------------------------------------------------
    const ICONS = {
      err: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>',
      ok: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
    };
    function toast(msg: string, kind: 'ok' | 'err' = 'err') {
      const stack = $('toast-stack');
      const el = document.createElement('div');
      const tone = kind === 'err' ? 'text-rose-300 border-rose-500/40' : 'text-emerald-300 border-emerald-500/40';
      el.className = `glass w-full flex items-center gap-2.5 px-4 py-3 rounded-xl text-base shadow-2xl animate-rise ${tone}`;
      el.setAttribute('role', 'alert');
      el.innerHTML = `<span class="shrink-0">${ICONS[kind]}</span><span class="flex-1">${msg}</span>`;
      stack.appendChild(el);
      setTimeout(() => {
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateY(10px)';
        setTimeout(() => el.remove(), 300);
      }, 3200);
    }

    function render() {
      const isSignup = mode === 'signup';
      nameWrap.style.maxHeight = isSignup ? '6rem' : '0';
      nameWrap.style.opacity = isSignup ? '1' : '0';
      submitLabel.textContent = isSignup ? 'Create account' : 'Log in';
      switchHint.innerHTML = isSignup
        ? 'Already have an account? <button id="goto-login" class="text-accent-soft underline">Log in</button>'
        : "New here? <button id=\"goto-signup\" class=\"text-accent-soft underline\">Create an account</button>";

      tabLogin.classList.toggle('bg-ink-600', !isSignup);
      tabLogin.classList.toggle('text-white', !isSignup);
      tabSignup.classList.toggle('bg-ink-600', isSignup);
      tabSignup.classList.toggle('text-white', isSignup);

      (document.getElementById('password') as HTMLInputElement).autocomplete =
        isSignup ? 'new-password' : 'current-password';
      ($('forgot-btn') as HTMLElement).style.display = isSignup ? 'none' : '';

      document.getElementById('goto-login')?.addEventListener('click', () => setMode('login'));
      document.getElementById('goto-signup')?.addEventListener('click', () => setMode('signup'));
    }

    function setMode(m: Mode) {
      mode = m;
      render();
    }

    tabLogin.addEventListener('click', () => setMode('login'));
    tabSignup.addEventListener('click', () => setMode('signup'));

    function setBusy(busy: boolean) {
      submitBtn.disabled = busy;
      submitBtn.style.opacity = busy ? '0.7' : '1';
      submitLabel.textContent = busy
        ? (mode === 'signup' ? 'Creating…' : 'Logging in…')
        : (mode === 'signup' ? 'Create account' : 'Log in');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      const password = String(data.get('password') || '');
      const username = String(data.get('username') || '').trim();

      // quick client-side checks → instant toast, no server round-trip
      if (mode === 'signup' && username.length < 2) return toast('Please enter your name.');
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return toast('Please enter a valid email address.');
      if (!password) return toast('Please enter your password.');
      if (mode === 'signup' && password.length < 6) return toast('Password must be at least 6 characters.');

      const payload: Record<string, string> = { email, password };
      if (mode === 'signup') payload.username = username;

      setBusy(true);
      try {
        const res = await fetch(`/api/auth/${mode}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          toast(body.error || 'Something went wrong. Please try again.');
          setBusy(false);
          return;
        }
        const name = body?.user?.username;
        toast(mode === 'signup' ? `Welcome aboard${name ? ', ' + name : ''}! 🎉` : `Welcome back${name ? ', ' + name : ''}!`, 'ok');
        submitLabel.textContent = 'Redirecting…';
        setTimeout(() => { window.location.href = '/app'; }, 650);
      } catch {
        toast('Network error — is the server running?');
        setBusy(false);
      }
    });

    // ---- show/hide password ---------------------------------------------------
    const EYE = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
    const EYE_OFF = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c6.5 0 10 7 10 7a13.3 13.3 0 0 1-2.16 2.92"/><path d="M6.6 6.6A13.3 13.3 0 0 0 2 12s3.5 7 10 7a9 9 0 0 0 4-.92"/><path d="m2 2 20 20"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>';
    const passInput = $('password') as HTMLInputElement;
    const eyeIcon = $('eye-icon');
    eyeIcon.innerHTML = EYE;
    $('toggle-pass').addEventListener('click', () => {
      const show = passInput.type === 'password';
      passInput.type = show ? 'text' : 'password';
      eyeIcon.innerHTML = show ? EYE_OFF : EYE;
    });

    // ---- forgot / reset password ----------------------------------------------
    const resetOverlay = $('reset-overlay');
    const resetForm = $('reset-form') as HTMLFormElement;
    const resetSubmit = $('reset-submit') as HTMLButtonElement;
    function openReset() {
      ($('reset-email') as HTMLInputElement).value = (document.getElementById('email') as HTMLInputElement).value.trim();
      resetOverlay.classList.remove('hidden');
      resetOverlay.classList.add('flex');
      setTimeout(() => ($('reset-email') as HTMLInputElement).focus(), 30);
    }
    function closeReset() {
      resetOverlay.classList.add('hidden');
      resetOverlay.classList.remove('flex');
      resetForm.reset();
    }
    $('forgot-btn').addEventListener('click', openReset);
    resetOverlay.querySelectorAll('[data-reset-close]').forEach((el) => el.addEventListener('click', closeReset));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !resetOverlay.classList.contains('hidden')) closeReset(); });

    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = ($('reset-email') as HTMLInputElement).value.trim();
      const p1 = ($('reset-pass') as HTMLInputElement).value;
      const p2 = ($('reset-pass2') as HTMLInputElement).value;
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return toast('Please enter a valid email address.');
      if (p1.length < 6) return toast('Password must be at least 6 characters.');
      if (p1 !== p2) return toast('Passwords do not match.');

      resetSubmit.disabled = true;
      resetSubmit.textContent = 'Resetting…';
      try {
        const res = await fetch('/api/auth/reset', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, password: p1 }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          toast(body.error || 'Could not reset password.');
        } else {
          toast('Password updated — you can log in now.', 'ok');
          (document.getElementById('email') as HTMLInputElement).value = email;
          closeReset();
          setMode('login');
        }
      } catch {
        toast('Network error — is the server running?');
      } finally {
        resetSubmit.disabled = false;
        resetSubmit.textContent = 'Reset';
      }
    });

    render();

    // remove the intro splash once it has finished (keeps the login interactive)
    setTimeout(() => document.getElementById('intro')?.remove(), 2750);
  </script>
</Base>
