---
import Base from '../layouts/Base.astro';
import { getUser } from '../lib/auth';

export const prerender = false;

const user = await getUser(Astro.cookies);
if (!user) return Astro.redirect('/');
---

<Base title="CLIDesk">
  <div id="app-root" class="h-screen w-screen flex overflow-hidden">
    <!-- ============================== SIDEBAR ============================== -->
    <aside id="sidebar" class="w-[270px] shrink-0 h-full flex flex-col glass border-r border-white/5">
      <!-- logo -->
      <div class="flex items-center gap-3 px-5 h-[68px] shrink-0 border-b border-white/5">
        <div class="w-9 h-9 rounded-xl grid place-items-center"
             style="background:linear-gradient(135deg,#fde047,#f97316);box-shadow:0 8px 22px -8px rgba(249,115,22,.6)">
          <span class="font-heading text-lg font-bold" style="color:#1a1205">&gt;_</span>
        </div>
        <span class="font-heading text-3xl grad-text">CLIDesk</span>
        <button id="sidebar-close" class="icon-btn lg:hidden ml-auto shrink-0" title="Close menu" aria-label="Close menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- new board -->
      <div class="px-3 pt-3">
        <button id="new-board-btn" class="btn btn-ghost w-full justify-start text-base">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Create new board
        </button>
      </div>

      <!-- tabs -->
      <nav id="tab-list" class="flex-1 overflow-y-auto px-3 py-3 space-y-1.5"></nav>

      <!-- search hint -->
      <button id="open-search-btn" class="mx-3 mb-2 btn btn-ghost justify-between text-sm text-mist-300">
        <span class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          Search everything
        </span>
        <span class="text-xs text-mist-400">Ctrl K</span>
      </button>

      <!-- user / logout -->
      <div class="border-t border-white/5 p-3 flex items-center gap-3">
        <div id="user-avatar" class="w-10 h-10 rounded-full grid place-items-center font-heading text-lg shrink-0"
             style="background:linear-gradient(135deg,#fde047,#f97316);color:#1a1205">?</div>
        <div class="min-w-0 flex-1">
          <div id="user-name" class="truncate text-mist-100 text-base leading-tight">User</div>
          <div id="user-email" class="truncate text-mist-400 text-xs leading-tight"></div>
        </div>
        <button id="logout-btn" title="Log out" class="icon-btn shrink-0">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
        </button>
      </div>
    </aside>

    <!-- =============================== MAIN =============================== -->
    <main class="flex-1 h-full flex flex-col min-w-0 relative overflow-hidden dotted-bg">
      <!-- board header -->
      <header class="h-[68px] shrink-0 flex items-center justify-between gap-3 px-4 sm:px-7 border-b border-white/5">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <button id="sidebar-toggle" class="icon-btn lg:hidden shrink-0" title="Menu" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <h1 id="board-title" class="font-heading text-2xl sm:text-3xl truncate grad-text"></h1>
          <span id="card-count" class="text-mist-400 text-base shrink-0 hidden sm:inline"></span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button id="delete-card-btn" class="btn btn-danger text-base shrink-0 hidden" title="Delete selected card">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <span class="hidden sm:inline">Delete</span>
            <span id="del-count" class="font-bold tabular-nums"></span>
          </button>
          <button id="add-card-btn" class="btn btn-primary text-base shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            <span class="hidden sm:inline">New card</span>
          </button>
        </div>
      </header>

      <!-- card grid -->
      <section id="card-grid" class="flex-1 overflow-y-auto p-4 sm:p-7"></section>
    </main>

    <!-- mobile sidebar backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden lg:hidden animate-fade"></div>
  </div>

  <!-- ============================ CARD MODAL ============================ -->
  <div id="card-modal" class="fixed inset-0 z-50 hidden"></div>

  <!-- =========================== SEARCH OVERLAY ========================= -->
  <div id="search-overlay" class="fixed inset-0 z-[60] hidden"></div>

  <!-- ============================== TOASTS ============================== -->
  <div id="toast-stack" class="fixed top-5 left-1/2 -translate-x-1/2 z-[70] flex flex-col items-center gap-2"></div>

  <!-- bootstrap user data for the client app -->
  <script is:inline define:vars={{ user }}>
    window.__CLIDESK_USER__ = user;
  </script>
  <script src="../scripts/app.ts"></script>
</Base>
