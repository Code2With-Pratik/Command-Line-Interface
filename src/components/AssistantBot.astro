---
// Reusable animated assistant bot: gradient orb, big tilted top hat, round glasses,
// blinking eyes, rosy cheeks, and four emotions (happy / sad / angry / mad).
// Emotion is driven by the data-face attribute on the #assistant wrapper (see global.css).
---
<svg viewBox="0 0 120 132" class="w-full h-full overflow-visible bot-svg">
  <defs>
    <radialGradient id="bot-body" cx="38%" cy="32%" r="82%">
      <stop offset="0%" stop-color="#fff6c2" />
      <stop offset="46%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#f97316" />
    </radialGradient>
    <radialGradient id="bot-shine" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <filter id="bot-glow" x="-60%" y="-60%" width="220%" height="220%">
      <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#f97316" flood-opacity="0.55" />
    </filter>
  </defs>

  <!-- body -->
  <circle cx="60" cy="72" r="46" fill="url(#bot-body)" filter="url(#bot-glow)" />
  <ellipse cx="44" cy="52" rx="21" ry="14" fill="url(#bot-shine)" opacity="0.85" />
  <circle cx="60" cy="72" r="46" fill="none" stroke="#fff7d6" stroke-opacity="0.35" stroke-width="1.5" />

  <!-- top hat -->
  <g transform="rotate(-12 60 26)">
    <ellipse cx="60" cy="34" rx="40" ry="8.5" fill="#23232a" />
    <rect x="40" y="2" width="40" height="33" rx="4" fill="#2c2c34" />
    <rect x="40" y="25" width="40" height="8" fill="#f97316" />
    <ellipse cx="60" cy="3" rx="20" ry="5" fill="#3a3a44" />
  </g>

  <!-- cheeks -->
  <ellipse class="bot-cheek" cx="37" cy="86" rx="8.5" ry="5.5" fill="#fb7185" opacity="0.7" />
  <ellipse class="bot-cheek" cx="83" cy="86" rx="8.5" ry="5.5" fill="#fb7185" opacity="0.7" />

  <!-- eyebrows -->
  <g class="bot-brow bot-brow-angry" stroke="#23232a" stroke-width="3.4" stroke-linecap="round">
    <line x1="34" y1="55" x2="55" y2="62" />
    <line x1="86" y1="55" x2="65" y2="62" />
  </g>
  <g class="bot-brow bot-brow-sad" stroke="#23232a" stroke-width="3.4" stroke-linecap="round">
    <line x1="36" y1="61" x2="55" y2="56" />
    <line x1="84" y1="61" x2="65" y2="56" />
  </g>

  <!-- glasses -->
  <g stroke="#23232a" stroke-width="3" fill="rgba(35,35,42,0.15)">
    <circle cx="46" cy="70" r="12.5" />
    <circle cx="74" cy="70" r="12.5" />
  </g>
  <line x1="58.5" y1="70" x2="61.5" y2="70" stroke="#23232a" stroke-width="3" />

  <!-- eyes (blink via CSS) -->
  <g class="bot-eyes" fill="#23232a">
    <circle cx="46" cy="70" r="4.6" />
    <circle cx="74" cy="70" r="4.6" />
  </g>

  <!-- mouths -->
  <path class="bot-mouth bot-mouth-happy" d="M50 84 C54 98, 66 98, 70 84 Z" fill="#23232a" />
  <path class="bot-mouth bot-mouth-sad" d="M50 95 Q60 84 70 95" fill="none" stroke="#23232a" stroke-width="3.6" stroke-linecap="round" />
  <path class="bot-mouth bot-mouth-angry" d="M51 93 Q60 87 69 93" fill="none" stroke="#23232a" stroke-width="3.6" stroke-linecap="round" />
  <g class="bot-mouth bot-mouth-mad">
    <ellipse cx="60" cy="92" rx="10.5" ry="7.5" fill="#23232a" />
    <rect x="51" y="86" width="18" height="3.4" rx="1" fill="#fff7d6" opacity="0.95" />
  </g>
</svg>
