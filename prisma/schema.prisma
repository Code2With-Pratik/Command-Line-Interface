// CLIDesk — Prisma schema (Prisma 7, driver-adapter based)
// Connection URLs live in prisma.config.ts (Prisma 7 requirement);
// the runtime connection is supplied via the pg driver adapter in src/lib/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String
  passwordHash String
  createdAt    DateTime  @default(now())

  sessions     Session[]
  boards       Board[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Board {
  id        String   @id @default(cuid())
  name      String
  position  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Card {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  color     String   @default("violet")
  isCode    Boolean  @default(false)
  language  String   @default("plaintext")
  pinned    Boolean  @default(false)
  favorite  Boolean  @default(false)
  position  Int      @default(0)
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}
